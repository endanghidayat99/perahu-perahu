# Konfigurasi di server. deploy.sh membuat .env dari berkas ini
# dan mengisi APP_VERSION setiap kali deploy.
COMPOSE_PROJECT_NAME=perahu-perahu
APP_VERSION=
APP_BIND=0.0.0.0
APP_PORT=7770
JAVA_OPTS=-Xms128m -Xmx1g

# Aturan room
GAME_MIN_PLAYERS=4
GAME_MAX_PLAYERS=5
# Pemain offline saat gilirannya dijalankan otomatis setelah sekian detik
GAME_OFFLINE_AUTOPLAY_SECONDS=45
# Batas waktu giliran untuk semua pemain (detik), 0 = tanpa batas
GAME_TURN_TIMEOUT_SECONDS=0
# Jeda langkah bot (milidetik)
GAME_BOT_DELAY_MILLIS=1200
GAME_LOBBY_OFFLINE_KICK_SECONDS=120
GAME_IDLE_ROOM_MINUTES=30
# Origin yang boleh membuka WebSocket, mis. https://perahu.contoh.id (pisahkan dengan koma). * = semua
GAME_ALLOWED_ORIGINS=*
